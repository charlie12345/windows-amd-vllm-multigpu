@@ -0,0 +1,22 @@
+/*
+ * Copyright 2026 Windows AMD vLLM Multi-GPU contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ * Added for native-Windows RCCL compatibility.
+ */
+
+#pragma once
+
+#include <winsock2.h>
+#include <chrono>
+
+static inline int gettimeofday(struct timeval* tv, void*) {
+  if (tv == nullptr) return -1;
+
+  const auto elapsed = std::chrono::system_clock::now().time_since_epoch();
+  const auto seconds = std::chrono::duration_cast<std::chrono::seconds>(elapsed);
+  const auto microseconds =
+      std::chrono::duration_cast<std::chrono::microseconds>(elapsed - seconds);
+  tv->tv_sec = static_cast<long>(seconds.count());
+  tv->tv_usec = static_cast<long>(microseconds.count());
+  return 0;
+}
