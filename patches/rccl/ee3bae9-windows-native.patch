+/*
+ * Copyright 2026 Windows AMD vLLM Multi-GPU contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ * Added for native-Windows RCCL compatibility.
+ */
+
+#ifndef RCCL_WINDOWS_COMPAT_DLFCN_H_
+#define RCCL_WINDOWS_COMPAT_DLFCN_H_
+
+#ifndef _WIN32
+#include_next <dlfcn.h>
+#else
+
+#include <Windows.h>
+
+#define RTLD_LAZY 0
+#define RTLD_NOW 1
+#define RTLD_LOCAL 0
+
+static thread_local char rcclWindowsDlError[256];
+static thread_local char rcclWindowsDlPath[32768];
+
+typedef struct {
+  const char* dli_fname;
+  void* dli_fbase;
+  const char* dli_sname;
+  void* dli_saddr;
+} Dl_info;
+
+static inline void rcclWindowsSetDlError(DWORD error) {
+  rcclWindowsDlError[0] = '\0';
+  FormatMessageA(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
+                 nullptr, error, 0, rcclWindowsDlError,
+                 static_cast<DWORD>(sizeof(rcclWindowsDlError)), nullptr);
+}
+
+static inline void* dlopen(const char* filename, int) {
+  HMODULE module = LoadLibraryA(filename);
+  if (module == nullptr) rcclWindowsSetDlError(GetLastError());
+  return reinterpret_cast<void*>(module);
+}
+
+static inline void* dlsym(void* handle, const char* symbol) {
+  FARPROC address = GetProcAddress(reinterpret_cast<HMODULE>(handle), symbol);
+  if (address == nullptr) rcclWindowsSetDlError(GetLastError());
+  return reinterpret_cast<void*>(address);
+}
+
+static inline void* dlvsym(void* handle, const char* symbol, const char*) {
+  return dlsym(handle, symbol);
+}
+
+static inline int dladdr(const void* address, Dl_info* info) {
+  if (address == nullptr || info == nullptr) return 0;
+  HMODULE module = nullptr;
+  if (!GetModuleHandleExA(
+          GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+              GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+          reinterpret_cast<LPCSTR>(address), &module)) {
+    rcclWindowsSetDlError(GetLastError());
+    return 0;
+  }
+  DWORD length = GetModuleFileNameA(
+      module, rcclWindowsDlPath,
+      static_cast<DWORD>(sizeof(rcclWindowsDlPath)));
+  if (length == 0 || length >= sizeof(rcclWindowsDlPath)) {
+    rcclWindowsSetDlError(GetLastError());
+    return 0;
+  }
+  info->dli_fname = rcclWindowsDlPath;
+  info->dli_fbase = reinterpret_cast<void*>(module);
+  info->dli_sname = nullptr;
+  info->dli_saddr = nullptr;
+  return 1;
+}
+
+static inline int dlclose(void* handle) {
+  if (handle == nullptr) return 0;
+  if (FreeLibrary(reinterpret_cast<HMODULE>(handle))) return 0;
+  rcclWindowsSetDlError(GetLastError());
+  return -1;
+}
+
+static inline const char* dlerror(void) {
+  return rcclWindowsDlError[0] == '\0' ? nullptr : rcclWindowsDlError;
+}
+
+#endif
+#endif
