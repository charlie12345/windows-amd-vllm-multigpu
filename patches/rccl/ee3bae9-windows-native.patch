+ *
+ * Windows fallbacks for optional Linux-only RCCL services.
+ *
+ * These symbols deliberately report no GIN/RMA devices and do not enable
+ * the CSV tuner or RAS monitor. Core collectives and the socket NET plugin
+ * remain real implementations.
+ *************************************************************************/
+
+#if defined(NCCL_OS_WINDOWS)
+
