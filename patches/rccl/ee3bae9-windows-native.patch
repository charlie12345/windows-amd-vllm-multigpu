+ncclResult_t ncclRmaGetDevCount(int rmaPluginIndex, int* nPhysDev, int* nVirtDev) {
+  (void)rmaPluginIndex;
+  if (nPhysDev != nullptr) *nPhysDev = 0;
+  if (nVirtDev != nullptr) *nVirtDev = -1;
+  return ncclSuccess;
+}
