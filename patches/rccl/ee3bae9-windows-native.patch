+ncclResult_t ncclGinInit(struct ncclComm* comm) {
+  comm->ginContext = nullptr;
+  comm->ginPluginIndex = -1;
+  if (comm->sharedRes != nullptr) {
+    comm->sharedRes->ginState.ncclGin = nullptr;
+    comm->sharedRes->ginState.ginType = NCCL_GIN_TYPE_NONE;
+    comm->sharedRes->ginState.connected = false;
+  }
+  return ncclSuccess;
+}
+
+ncclResult_t ncclGinInitFromParent(struct ncclComm* comm, struct ncclComm* parent) {
+  (void)parent;
+  return ncclGinInit(comm);
+}
