  * See LICENSE.txt for license information
  ************************************************************************/
 
+#ifdef _WIN32
+
+#include <errno.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+#include <hip/hip_runtime_api.h>
+
+#include "alt_rsmi.h"
+#include "debug.h"
+
+static int ARSMI_num_devices = -1;
+
+static int hipToErrno(hipError_t status, const char* operation) {
+  if (status == hipSuccess) return 0;
+  WARN("%s failed: %s", operation, hipGetErrorString(status));
+  return EIO;
+}
+
+int ARSMI_init(void) {
+  if (ARSMI_num_devices >= 0) return 0;
+
+  int count = 0;
+  hipError_t status = hipGetDeviceCount(&count);
+  if (status == hipErrorNoDevice) {
+    ARSMI_num_devices = 0;
+    return 0;
+  }
+  int result = hipToErrno(status, "hipGetDeviceCount");
+  if (result != 0) return result;
+
+  ARSMI_num_devices = count;
+  INFO(NCCL_INIT, "Windows topology fallback discovered %d HIP devices", count);
+  return 0;
+}
+
+int ARSMI_get_num_devices(uint32_t* num_devices) {
+  if (num_devices == nullptr) return EINVAL;
+  int result = ARSMI_init();
+  if (result != 0) return result;
+  *num_devices = static_cast<uint32_t>(ARSMI_num_devices);
+  return 0;
+}
+
+int ARSMI_dev_pci_id_get(uint32_t device_index, uint64_t* bdfid) {
+  if (bdfid == nullptr) return EINVAL;
+  int result = ARSMI_init();
+  if (result != 0) return result;
+  if (device_index >= static_cast<uint32_t>(ARSMI_num_devices)) return EINVAL;
+
+  char bus_id[32] = {};
+  result = hipToErrno(hipDeviceGetPCIBusId(bus_id, sizeof(bus_id), static_cast<int>(device_index)),
+                      "hipDeviceGetPCIBusId");
+  if (result != 0) return result;
+
+  unsigned int domain = 0, bus = 0, device = 0, function = 0;
+  if (sscanf(bus_id, "%x:%x:%x.%x", &domain, &bus, &device, &function) != 4) {
+    WARN("Unable to parse HIP PCI bus ID '%s'", bus_id);
+    return EINVAL;
+  }
+
+  *bdfid = (static_cast<uint64_t>(domain) << 32) |
+           (static_cast<uint64_t>(bus) << 8) |
+           (static_cast<uint64_t>(device) << 3) |
+           static_cast<uint64_t>(function);
+  return 0;
+}
+
+int ARSMI_topo_get_link_info(uint32_t src, uint32_t dst, ARSMI_linkInfo* info) {
+  if (info == nullptr) return EINVAL;
+  int result = ARSMI_init();
+  if (result != 0) return result;
+  if (src >= static_cast<uint32_t>(ARSMI_num_devices) ||
+      dst >= static_cast<uint32_t>(ARSMI_num_devices)) return EINVAL;
+
+  int peer_access = 0;
+  result = hipToErrno(hipDeviceCanAccessPeer(&peer_access, static_cast<int>(src), static_cast<int>(dst)),
+                      "hipDeviceCanAccessPeer");
+  if (result != 0) return result;
+
+  memset(info, 0, sizeof(*info));
+  info->src_node = src;
+  info->dst_node = dst;
+  info->type = ARSMI_IOLINK_TYPE_PCIEXPRESS;
+  info->hops = src == dst ? 0 : (peer_access ? 1 : 2);
+  info->weight = src == dst ? 0 : (peer_access ? 20 : 40);
+  return 0;
+}
+
+int ARSMI_get_fw_version(uint32_t, uint64_t* fw_version) {
+  if (fw_version == nullptr) return EINVAL;
+  *fw_version = 0;
+  return 0;
+}
+
+int ARSMI_get_fabric_info(uint32_t, struct ARSMI_fabricInfo* info) {
+  if (info == nullptr) return EINVAL;
+  memset(info, 0, sizeof(*info));
+  info->fabric_type = ARSMI_FABRIC_TYPE_UNKNOWN;
+  info->accel_state = ARSMI_FABRIC_ACCELERATOR_VPOD_STATE_UNKNOWN;
+  info->addr_mode = ARSMI_FABRIC_NPA_ADDRESS_MODE_UNKNOWN;
+  return ENODEV;
+}
+
+const char* ARSMI_fabric_telem_id_to_string(uint64_t) {
+  return "UNKNOWN";
+}
+
