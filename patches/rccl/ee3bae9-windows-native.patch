+static inline int getpid(void) { return _getpid(); }
+static inline int access(const char* path, int mode) { return _access(path, mode); }
+static inline int close(int fd) {
+  // POSIX close(-1) reports EBADF. The Windows CRT instead invokes its
+  // invalid-parameter handler, which terminates the process with
+  // FAST_FAIL_INVALID_ARG unless a custom handler is installed.
+  if (fd < 0) {
+    errno = EBADF;
+    return -1;
+  }
+  return _close(fd);
+}
+static inline int read(int fd, void* buffer, unsigned int count) { return _read(fd, buffer, count); }
+static inline int write(int fd, const void* buffer, unsigned int count) { return _write(fd, buffer, count); }
+
+static inline long sysconf(int name) {
+  if (name != _SC_PAGESIZE) return -1;
+  SYSTEM_INFO info;
+  GetSystemInfo(&info);
+  return static_cast<long>(info.dwPageSize);
+}
+
+static inline int usleep(unsigned long microseconds) {
+  Sleep(static_cast<DWORD>((microseconds + 999) / 1000));
+  return 0;
+}
+
+static inline unsigned int sleep(unsigned int seconds) {
+  Sleep(seconds * 1000U);
+  return 0;
+}
+
+#endif
+#endif
