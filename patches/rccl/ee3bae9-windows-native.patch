+/*
+ * Copyright 2026 Windows AMD vLLM Multi-GPU contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ * Added for native-Windows RCCL compatibility.
+ */
+
+#ifndef RCCL_WINDOWS_COMPAT_PTHREAD_H_
+#define RCCL_WINDOWS_COMPAT_PTHREAD_H_
+
+#ifndef _WIN32
+#include_next <pthread.h>
+#else
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+
+// wingdi.h reserves ERROR as a numeric macro, while RCCL uses ERROR(...) for
+// logging.  RCCL's definition is the one host translation units need.
+#ifdef ERROR
+#undef ERROR
+#endif
+
+typedef SRWLOCK pthread_mutex_t;
+typedef INIT_ONCE pthread_once_t;
+typedef HANDLE pthread_t;
+
+#define PTHREAD_MUTEX_INITIALIZER SRWLOCK_INIT
+#define PTHREAD_ONCE_INIT INIT_ONCE_STATIC_INIT
+
+static inline int pthread_mutex_init(pthread_mutex_t* mutex, const void*) {
+  InitializeSRWLock(mutex);
+  return 0;
+}
+
+static inline int pthread_mutex_destroy(pthread_mutex_t*) { return 0; }
+
+static inline int pthread_mutex_lock(pthread_mutex_t* mutex) {
+  AcquireSRWLockExclusive(mutex);
+  return 0;
+}
+
+static inline int pthread_mutex_unlock(pthread_mutex_t* mutex) {
+  ReleaseSRWLockExclusive(mutex);
+  return 0;
+}
+
+static inline BOOL CALLBACK rcclWindowsPthreadOnceCallback(PINIT_ONCE, PVOID parameter, PVOID*) {
+  reinterpret_cast<void (*)(void)>(parameter)();
+  return TRUE;
+}
+
+static inline int pthread_once(pthread_once_t* once, void (*initRoutine)(void)) {
+  return InitOnceExecuteOnce(once, rcclWindowsPthreadOnceCallback,
+                             reinterpret_cast<PVOID>(initRoutine), nullptr)
+           ? 0
+           : static_cast<int>(GetLastError());
+}
+
+static inline int pthread_setname_np(pthread_t thread, const char* name) {
+  if (thread == nullptr || name == nullptr) return ERROR_INVALID_PARAMETER;
+  int chars = MultiByteToWideChar(CP_UTF8, 0, name, -1, nullptr, 0);
+  if (chars <= 0) return static_cast<int>(GetLastError());
+  wchar_t stackName[64];
+  if (chars > static_cast<int>(sizeof(stackName) / sizeof(stackName[0]))) return ERROR_BUFFER_OVERFLOW;
+  if (MultiByteToWideChar(CP_UTF8, 0, name, -1, stackName,
+                          static_cast<int>(sizeof(stackName) / sizeof(stackName[0]))) == 0)
+    return static_cast<int>(GetLastError());
+  HRESULT result = SetThreadDescription(thread, stackName);
+  return SUCCEEDED(result) ? 0 : static_cast<int>(result);
+}
+
+#endif
+#endif
