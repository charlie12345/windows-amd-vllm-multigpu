+def _shutdown_core_processes(
+    processes: list[BaseProcess],
+    shutdown_event=None,
+    timeout: float | None = None,
+) -> None:
+    """Cooperatively stop EngineCore children before forced termination.
+
+    ``multiprocessing.Process.terminate()`` uses ``TerminateProcess`` on
+    Windows, bypassing Python signal handlers and EngineCore's worker cleanup.
+    Give Windows children an explicit, spawn-safe shutdown event first so HIP
+    contexts and tensor-parallel workers are released normally.
+    """
+    if shutdown_event is not None:
+        shutdown_event.set()
+        grace_timeout = 5.0 if timeout is None else timeout
+        deadline = time.monotonic() + grace_timeout
+        for proc in processes:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                break
+            if proc.is_alive():
+                proc.join(remaining)
+
+    shutdown(processes, timeout=timeout)
+
+
 class CoreEngineState(Enum):
     NEW = auto()
     CONNECTED = auto()
