diff --git a/vllm/v1/spec_decode/eagle.py b/vllm/v1/spec_decode/eagle.py
index 002d0b783..b59a18bae 100644
--- a/vllm/v1/spec_decode/eagle.py
+++ b/vllm/v1/spec_decode/eagle.py
@@ -4,6 +4,7 @@
 import torch
 
 from vllm.config import VllmConfig
+from vllm.model_executor.models.utils import get_draft_quant_config
 from vllm.v1.spec_decode.llm_base_proposer import SpecDecodeBaseProposer
 
 
@@ -20,3 +21,19 @@ class EagleProposer(SpecDecodeBaseProposer):
             pass_hidden_states_to_model=True,
             runner=runner,
         )
+
+    def _create_draft_vllm_config(self) -> VllmConfig:
+        """Use the draft checkpoint's quantization, not the target's.
+
+        MTP normally stores its head in the target checkpoint, so both configs
+        resolve to the same quantization. An explicit standalone MTP/EAGLE
+        checkpoint may intentionally keep its head unquantized while the
+        target is quantized; carrying the target quantization object into that
+        model creates packed parameters for BF16 weights and makes loading fail.
+        """
+        draft_vllm_config = super()._create_draft_vllm_config()
+        # VllmConfig.__post_init__ derives quant_config from model_config, so a
+        # dataclass replace would immediately restore the target's value. Set
+        # the resolved draft value after construction instead.
+        draft_vllm_config.quant_config = get_draft_quant_config(draft_vllm_config)
+        return draft_vllm_config
