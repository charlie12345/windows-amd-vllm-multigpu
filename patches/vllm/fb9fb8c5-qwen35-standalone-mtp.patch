+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import pytest
+from transformers import PretrainedConfig
+
+from vllm.config.speculative import SpeculativeConfig
+
+
+@pytest.mark.cpu_test
+@pytest.mark.parametrize(
+    ("model_type", "expected_architecture"),
+    [
+        ("qwen3_5_text", "Qwen3_5MTP"),
+        ("qwen3_5_moe_text", "Qwen3_5MoeMTP"),
+    ],
+)
+def test_qwen3_5_text_config_maps_to_mtp(model_type, expected_architecture):
+    config = PretrainedConfig(
+        architectures=["Qwen3_5ForCausalLM"],
+        model_type=model_type,
+        mtp_num_hidden_layers=1,
+    )
+
+    out = SpeculativeConfig.hf_config_override(config)
+
+    assert out.model_type == "qwen3_5_mtp"
+    assert out.architectures == [expected_architecture]
+    assert out.n_predict == 1
